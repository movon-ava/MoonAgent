# ===== 妯″瀷 =====
# DeepSeek锛圤penAI 鍏煎锛涘彧閰嶈繖涓€瀹朵篃鑳借窇 solver + coordinator锛?
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 涓嶄紶 --models 鏃朵娇鐢ㄧ殑妯″瀷锛堥€楀彿鍒嗛殧锛宲rovider/model/effort锛?
DEFAULT_MODELS=deepseek/deepseek-flash

# 鍏朵粬 provider锛堝彲閫夛級
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== 杩愯妯″紡 =====
# 鍙媺鍙栬繖浜涙柟鍚戠殑棰樼洰锛坵eb/misc/pwn/re/crypto锛岄€楀彿鍒嗛殧锛沘ll = 鍏ㄩ兘鎷夛級
CHALLENGE_CATEGORIES=web,misc,pwn,re,crypto
# 鍙媺鍙栬繖浜涢毦搴︾殑棰樼洰锛堝叆闂?绠€鍗?涓瓑/鍥伴毦锛岄€楀彿鍒嗛殧锛涚暀绌?= 鍏ㄩ儴锛涜嫳鏂?easy/medium/hard 涔熻锛?
CHALLENGE_DIFFICULTY=
# 涓€杞В澶氬皯棰橈細鎷夊彇 N 閬撴湭瑙ｉ鐩紝瑙ｅ畬/璺戝畬灏遍€€鍑猴紙0 = 鍏抽棴锛岃蛋甯搁┗ coordinator锛?
ROUND_SIZE=0
# 骞跺彂瑙ｉ鏁帮紙鍚屾椂鍋氬嚑閬撻锛夈€俉eb 绔€岃繍琛屾帶鍒躲€嶇殑骞跺彂鏁颁細鍐欏洖杩欓噷锛岃繍琛屼腑鍙疄鏃舵敼
MAX_CONCURRENT_CHALLENGES=10
# 鍗曢鏃堕棿涓婇檺锛堝垎閽燂紝0 = 涓嶉檺锛夈€傝秴鏃跺悗鏀惧純璇ラ锛屾妸骞跺彂浣嶈缁欎笅涓€棰?
CHALLENGE_TIMEOUT_MIN=0
# 一题没解出来时额外重试几轮（0 = 不重试）
CHALLENGE_EXTRA_ROUNDS=0
# 闈舵満缁湡蹇冭烦锛堢锛? = 鍏抽棴锛夈€傛瘡闅旇繖涔堜箙缁欐鍦ㄨВ鐨勯缁竴娆″疄渚嬪鍛斤紝闃叉鍋氫竴鍗婅繃鏈?
ENV_HEARTBEAT_S=300
# 杞妯″紡蹇界暐浣庝簬璇ュ垎鍊肩殑棰橈紙0 鍒嗛澶氫负娴锋姤/绛惧埌绫伙紝榛樿璺宠繃锛?
ROUND_MIN_SCORE=1
# 鍙В鍚嶅瓧鍖呭惈杩欎簺鏂囧瓧鐨勯锛堥€楀彿鍒嗛殧锛岀暀绌?= 涓嶈繃婊わ級
ROUND_ONLY=
# 閫夐鏂瑰紡锛歳andom锛堥粯璁わ紝闅忔満鎶斤級/ score锛堝垎鍊间粠浣庡埌楂橈級/ name锛堟寜鍚嶅瓧锛?
ROUND_ORDER=random
# 璺宠繃鏈€杩?N 灏忔椂鍐呭仛杩囩殑棰橈紝閬垮厤姣忚疆閲嶅鎶藉埌鍚屼竴鎵癸紙0 = 鍏抽棴锛?
ROUND_COOLDOWN_HOURS=6
# 1 = 宸茶В棰樹篃鏀捐繘鍊欓€夋睜锛堟鏃跺喎鍗存椂闂翠笉鐢熸晥锛屽凡瑙?鏈В涓€璧锋娊锛涢厤鍚?--only 鎸囧畾棰樼洰鏈€绋筹級
ROUND_INCLUDE_SOLVED=0
# 1 = 鍒烽妯″紡锛氫竴鎵瑰彧瑙ｄ竴涓柟鍚戯紙misc 鈫?re 鈫?crypto 鈥︼級锛屾壒鍐呴毦搴︿氦閿?
ROUND_ROTATE=0
# 鍒烽妯″紡鐨勬壒澶у皬锛? = 绛変簬骞跺彂鏁帮級
ROTATE_BATCH=0
# 娌欑宸ヤ綔鐩綍锛堣В鍘嬪ぇ闄勪欢鐢紝榛樿 F:\ctf_agent\workspaces锛岄伩鍏嶅崰婊?C 鐩橈級
CTF_WORKSPACE_ROOT=F:\ctf_agent\workspaces
# flag 鏍煎紡涓庢彁浜よ鍒欐枃浠讹紙鍙嚜鐢变慨鏀癸級
INSTRUCTIONS_FILE=INSTRUCTIONS.md
MAX_ENVIRONMENTS=0
# 骞冲彴 API 璇锋眰鏈€灏忛棿闅旓紙绉掞級銆侱ASCTF/CTF虏 闄愭祦寰堜弗锛屼綆浜?0.8 瀹规槗 429
PLATFORM_REQUEST_INTERVAL=0.8
# 涓嶉渶瑕侀澏鏈虹殑棰樻渶澶氬悓鏃惰窇鍑犱釜锛堥檮浠堕姹狅級
