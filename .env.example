# ===== 平台选择 =====
# auto: 配了哪个平台的凭证就用哪个（ret2shell → dasctf → ctf2 → ctfplus → ctfd）
PLATFORM=auto

# --- 西电 CTF 终端 / Ret2Shell (MoeCTF 2026) ---
RET2SHELL_URL=https://ctf.xidian.edu.cn
# 浏览器控制台执行 localStorage.account.token，把结果整段粘贴到这里
RET2SHELL_TOKEN=
# 比赛 ID（留空 = 当前比赛）
RET2SHELL_GAME=

# --- DASCTF / 羊城杯（AI Agent 接口）---
DASCTF_URL=https://pro.dasctf.com
# 平台「接入凭证」里的 ACCESSKEY
DASCTF_ACCESS_KEY=

# --- CTF² Agent Arena（练习中心）---
CTF2_URL=https://ctf2.dasctf.com
CTF2_AGENT_TOKEN=
# 练习场 UUID（留空 = 用默认练习场）
CTF2_GROUND=

# --- CTFd（自建靶场 / 内部赛）---
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# --- CTF+ / 极客挑战赛 ---
CTFPLUS_URL=https://geek2026.play.ctfplus.cn
# 浏览器里 SessionStore 这个 cookie 的值（很长的 MTC5… 串）
CTFPLUS_TOKEN=

# ===== 模型 =====
# DeepSeek（OpenAI 兼容）：solver 和 coordinator 都用它
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 不传 --models 时使用的模型，逗号分隔；deepseek/deepseek-flash 最便宜
DEFAULT_MODELS=deepseek/deepseek-flash
# 便宜模型只干杂活，JSON 形如 {"writeup": "deepseek/deepseek-flash"}
ROLE_MODELS=

# 其他 provider（未使用时可留空）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== 解题范围 =====
# 只解这些方向，逗号分隔；all = 不限
CHALLENGE_CATEGORIES=web,misc,pwn,re,crypto
# 只解这些难度（入门,简单,中等,困难）；留空 = 不限
CHALLENGE_DIFFICULTY=
# 0 = 用协调器持续解题（不设上限），N = 这一轮最多做 N 题
ROUND_SIZE=0
# 同时解几道题
MAX_CONCURRENT_CHALLENGES=10
# 单题超时（分钟），0 = 不限
CHALLENGE_TIMEOUT_MIN=0
# 没解出来的题额外重试几轮（只对「失败/未解」重试，超时和主动跳过不重试）
CHALLENGE_EXTRA_ROUNDS=0
# 靶机心跳续期间隔（秒）
ENV_HEARTBEAT_S=300

# ===== 选题策略 =====
ROUND_MIN_SCORE=1
# 只解名字包含这些文字的题（逗号分隔，留空 = 不过滤）
ROUND_ONLY=
# 选题方式：random（默认，难度加权随机）/ score（分值从低到高）/ name（按名字）
ROUND_ORDER=random
# 跳过最近 N 小时内做过的题（0 = 关闭）
ROUND_COOLDOWN_HOURS=6
# 1 = 已解题也放进候选池（此时冷却不生效；配 --only 指定题目时最稳）
ROUND_INCLUDE_SOLVED=0
# 1 = 刷题模式：一批只解一个方向（misc → re → pwn → crypto …），批内难度交错
ROUND_ROTATE=0
# 刷题模式的批大小（0 = 等于并发数）
ROTATE_BATCH=0

# ===== 沙箱 =====
# 解题容器镜像（用 sandbox/Dockerfile.sandbox 构建）
SANDBOX_IMAGE=ctf-sandbox
# 单个容器内存上限
CONTAINER_MEMORY_LIMIT=16g
# 沙箱工作目录（解压大附件用，别放 C 盘）
CTF_WORKSPACE_ROOT=F:\ctf_agent\workspaces
# flag 格式与提交规则文件（可自由修改）
INSTRUCTIONS_FILE=INSTRUCTIONS.md

# ===== 平台限流与并发 =====
# 同时开几个靶机（0 = 按平台配额；平台通常只允许 1~2 个）
MAX_ENVIRONMENTS=2
# 平台 API 请求最小间隔（秒）；DASCTF / CTF² 限流很严，低于 0.8 容易 429
PLATFORM_REQUEST_INTERVAL=0.8
# 不需要靶机的题最多同时跑几个（附件题池）
MAX_ATTACHMENT_WORKERS=4
# 需要靶机的题最多同时跑几个（0 = 用平台配额）
MAX_TARGET_WORKERS=0
# 同一道题最多尝试几次（跨轮累计）
MAX_ATTEMPTS_PER_CHALLENGE=3

# ===== 输出与行为 =====
# 1 = 每道解出的题自动写一份中文 Writeup 到 writeups/
WRITEUP_ENABLED=0
WRITEUP_DIR=writeups
# flag 形如 moectf{} / SYC{}（只作为提示 + 软校验）；提交格式 full 或 inner
FLAG_FORMAT=
FLAG_SUBMIT_MODE=full
# 1 = 让模型用简体中文思考；0 = 用模型默认语言
THINK_CHINESE=1
# 1 = 拉题时平台已解出的题直接跳过
SKIP_SOLVED_PULL=1
# 1 = 提交 flag 必须带 evidence（防止瞎猜浪费提交次数）
REQUIRE_FLAG_EVIDENCE=1
# 1 = 注入 knowledge/<方向>.md 的经验清单；0 = 不注入
KNOWLEDGE_ENABLED=1
# 1 = 日志/轨迹里的 flag、API key、JWT 打码（flag{abcd…wxyz}）；0 = 保留原文
TRACE_MASK=1
# 单个 solver 的上下文上限（字符），超过就压缩旧消息
CONTEXT_LIMIT_CHARS=200000
